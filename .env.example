# Açaí Wave — Environment Variables (opcional)

# Porta do Vite dev server (padrão: 5173)
VITE_DEV_PORT=5173

# Configuração de impressora (opcional — configurada via UI)
# PRINTER_KITCHEN_IP=192.168.1.100
# PRINTER_FRONT_NAME=TANCA

# Ambiente (dev | production)
NODE_ENV=development

# Diretório de logs (padrão: userData/logs) — usado por `npm run log`
# CONTEXTO_LOGGING_DIR=/caminho/para/logs

# ⚠️ DADOS PESSOAIS DO LICENCIANTE — PREENCHA APENAS EM .env.local
# (o .env.local é ignorado pelo git; estes dados NUNCA vão ao GitHub)
# Usados para preencher build/LICENSE.txt e build/EULA.txt automaticamente.
# BUILD_LICENSE_OWNER="Seu Nome Completo"
# BUILD_LICENSE_DOCUMENT="Seu CPF ou CNPJ"

# Sentry DSN (error tracking em produção)
# Obtenha em: https://sentry.io/settings/projects/<project>/keys/
# O Sentry só envia dados em produção (NODE_ENV=production)
# VITE_SENTRY_DSN=https://***@oXXXXXXX.ingest.sentry.io/XXXXXXX

# ─── Sentry Source Maps (upload automático via @sentry/vite-plugin) ───
# Token de autenticação do Sentry para upload de source maps
# Obtenha em: https://sentry.io/settings/auth-tokens/
# Necessário apenas em CI/CD (GitHub Actions secrets)
# SENTRY_AUTH_TOKEN=seu_token_aqui

# Organização e projeto no Sentry (padrões: acai-wave / acai-wave-pdv)
# SENTRY_ORG=acai-wave
# SENTRY_PROJECT=acai-wave-pdv

# Versão do app (usada como release no Sentry)
# VITE_APP_VERSION=1.3.7

# ─── Analytics / Web Vitals ───
# Endpoint para envio das métricas (obrigatório para backend 'custom')
# VITE_ANALYTICS_ENDPOINT=https://analytics.suaempresa.com/collect

# Backend: 'custom' | 'ga4' | 'segment' (padrão: custom)
# VITE_ANALYTICS_BACKEND=custom

# Taxa de amostragam 0-1 (padrão: 1.0 = 100%)
# VITE_ANALYTICS_SAMPLE_RATE=1

# Máximo de métricas por lote (padrão: 10)
# VITE_ANALYTICS_BATCH_SIZE=10

# Intervalo entre envios em ms (padrão: 5000)
# VITE_ANALYTICS_BATCH_INTERVAL=5000

# Logs de debug (padrão: false)
# VITE_ANALYTICS_DEBUG=false

# ─── GA4 (se backend = 'ga4') ───
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GA4_API_SECRET=sua_api_secret

# ─── Segment (se backend = 'segment') ───
# VITE_SEGMENT_WRITE_KEY=sua_write_key

# ─── Alertas de Performance ───
# Habilita/desabilita o sistema de alertas (padrão: true em produção)
# VITE_ALERTS_ENABLED=true

# Canais de notificação: 'console' | 'slack' | 'email' (separados por vírgula)
# VITE_ALERTS_CHANNELS=console,slack,email

# Cooldown entre alertas do mesmo tipo em ms (padrão: 60000 = 1 minuto)
# VITE_ALERTS_COOLDOWN_MS=60000

# Tempo para escalar alerta crítico em ms (padrão: 300000 = 5 minutos)
# VITE_ALERTS_ESCALATION_MS=300000

# Logs de debug (padrão: false)
# VITE_ALERTS_DEBUG=false

# ─── Slack (se canal = 'slack') ───
# URL do webhook do Slack (crie em https://api.slack.com/messaging/webhooks)
# VITE_ALERTS_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ─── Email (se canal = 'email') ───
# Nota: Em app Electron, o envio de email é feito via IPC para o main process.
# Estas variáveis são usadas para configurar o transporte SMTP no main process.
# VITE_ALERTS_EMAIL_SMTP_HOST=smtp.gmail.com
# VITE_ALERTS_EMAIL_SMTP_PORT=587
# VITE_ALERTS_EMAIL_USER=seu_email@gmail.com
# VITE_ALERTS_EMAIL_PASS=sua_senha_app
# VITE_ALERTS_EMAIL_FROM=Açaí Wave <seu_email@gmail.com>
# VITE_ALERTS_EMAIL_TO=admin@empresa.com,dev@empresa.com

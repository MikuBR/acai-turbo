# Açaí Wave — Environment Variables (opcional)

# Porta do Vite dev server (padrão: 5173)
VITE_DEV_PORT=5173

# Configuração de impressora (opcional — configurada via UI)
# PRINTER_KITCHEN_IP=192.168.1.100
# PRINTER_FRONT_NAME=TANCA

# Ambiente (dev | production)
NODE_ENV=development

# Diretório de logs (padrão: userData/logs) — usado por `npm run log`
# CONTEXTO_LOGGING_DIR=/caminho/para/logs

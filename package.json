{
  "name": "acai-wave",
  "private": true,
  "version": "1.1.1",
  "license": "PROPRIETARY",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173/ && npx electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "lint": "eslint src/ database/ scripts/",
    "test": "npm run rebuild:node && vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:watch": "npm run rebuild:node && vitest",
    "test:coverage": "npm run rebuild:node && vitest run --coverage",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:all": "npm run rebuild:node && npm run rebuild:native",
    "swap:electron": "node scripts/swap-native-abi.cjs electron",
    "swap:node": "node scripts/swap-native-abi.cjs node",
    "swap:status": "node scripts/swap-native-abi.cjs status",
    "postinstall": "electron-builder install-app-deps && npm run rebuild:native",
    "build:win": "vite build && electron-builder --win --x64 --publish never",
    "package:win": "electron-builder --win --x64 --publish never",
    "generate:icons": "node scripts/generate-icons.cjs",
    "generate:header": "node scripts/generate-installer-header.cjs",
    "generate:license": "node scripts/generate-license-templates.cjs",
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "check:native": "node scripts/check-native-abi.cjs",
    "check:node": "node -e \"require('better-sqlite3'); console.log('Node ABI OK:', process.versions.modules)\"",
    "typecheck": "tsc --noEmit",
    "log": "node scripts/log-viewer.cjs",
    "ci": "npm run lint && npm run typecheck && npm run rebuild:node && npm run check:node && npm run test:ci && npm run rebuild:native && npm run check:native"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.21.0",
    "node-thermal-printer": "^4.6.0",
    "pdfmake": "^0.3.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "winston": "^3.19.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "ico-endec": "^0.1.6",
    "jsdom": "^25.0.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.15",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "terser": "^5.50.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.12",
    "vite-plugin-mkcert": "^1.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.1.5",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "build": {
    "appId": "com.acaiwave.app",
    "productName": "Açaí Wave",
    "icon": "build/icon",
    "asarUnpack": [
      "node_modules/better-sqlite3",
      "database/migrations/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.js",
      "database/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/installer-icon.ico",
      "uninstallerIcon": "build/installer-icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "include": "build/custom.nsh",
      "license": "build/EULA.txt",
      "artifactName": "Açaí Wave Setup ${version}.exe"
    }
  }
}

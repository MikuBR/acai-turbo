{
  "name": "acai-wave",
  "private": true,
  "version": "1.4.20",
  "license": "PROPRIETARY",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173/ && npx electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "lint": "eslint src/ database/ scripts/",
    "test": "node scripts/install-sqlite-bindings.cjs && vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "test:watch": "node scripts/install-sqlite-bindings.cjs && vitest",
    "test:coverage": "node scripts/install-sqlite-bindings.cjs && vitest run --coverage",
    "rebuild:node": "node scripts/install-sqlite-bindings.cjs --node-only",
    "rebuild:native": "node scripts/install-sqlite-bindings.cjs --electron-only",
    "rebuild:all": "node scripts/install-sqlite-bindings.cjs",
    "swap:electron": "node scripts/swap-native-abi.cjs electron",
    "swap:node": "node scripts/swap-native-abi.cjs node",
    "swap:status": "node scripts/swap-native-abi.cjs status",
    "postinstall": "electron-builder install-app-deps && node scripts/install-sqlite-bindings.cjs",
    "build:win": "vite build && electron-builder --win --x64 --publish never",
    "package:win": "electron-builder --win --x64 --publish never",
    "generate:icons": "node scripts/generate-icons.cjs",
    "generate:header": "node scripts/generate-installer-header.cjs",
    "generate:license": "node scripts/generate-license-templates.cjs",
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "check:native": "node scripts/check-native-abi.cjs",
    "check:node": "node -e \"require('better-sqlite3'); console.log('Node ABI OK:', process.versions.modules)\"",
    "verify:sourcemaps": "node scripts/verify-sourcemaps.cjs",
    "verify:sourcemaps:strict": "node scripts/verify-sourcemaps.cjs --strict",
    "typecheck": "tsc --noEmit",
    "log": "node scripts/log-viewer.cjs",
    "ci": "npm run lint && npm run typecheck && node scripts/install-sqlite-bindings.cjs && npm run test:ci"
  },
  "dependencies": {
    "@sentry/electron": "7.6.0",
    "@sentry/react": "^8.55.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.1.8",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.21.0",
    "node-thermal-printer": "^4.6.0",
    "pdfmake": "^0.3.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.2",
    "web-vitals": "^6.2.2",
    "winston": "^3.19.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^2.23.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "32.3.3",
    "electron-builder": "^25.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "ico-endec": "^0.1.6",
    "jsdom": "^25.0.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.15",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "terser": "^5.50.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^1.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.1.5",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "build": {
    "appId": "com.acaiwave.app",
    "productName": "Açaí Wave",
    "icon": "build/icon.ico",
    "asarUnpack": [
      "node_modules/better-sqlite3",
      "database/migrations/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.js",
      "database/**/*",
      "main/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "acai-wave-setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/installer-icon.ico",
      "uninstallerIcon": "build/installer-icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "include": "build/custom.nsh",
      "license": "build/EULA.txt"
    },
    "publish": {
      "provider": "github",
      "owner": "MikuBR",
      "repo": "acai-turbo"
    }
  },
  "allowScripts": true
}
